# ============================================================
# Growth Sales Academy LMS — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ------------------------------------------------------------
# DATABASE — PostgreSQL connection string
# Used by Prisma and passed to the Next.js app container
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# ------------------------------------------------------------

# Local development (outside Docker) — port 5433 avoids conflict with native PostgreSQL
DATABASE_URL=postgresql://gsa_user:gsa_password@127.0.0.1:5433/gsa_db?schema=public

# Inside Docker Compose (app container connecting to db service) — use port 5432
# DATABASE_URL=postgresql://gsa_user:gsa_password@db:5432/gsa_db?schema=public

# ------------------------------------------------------------
# NEXTAUTH — Authentication secrets
# Docs: https://next-auth.js.org/configuration/options
# ------------------------------------------------------------

# Full URL of the deployed app (no trailing slash)
# Local: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL=http://localhost:3000

# Random secret used to sign JWT tokens — generate with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=replace_with_a_strong_random_secret

# ------------------------------------------------------------
# NODE ENVIRONMENT
# ------------------------------------------------------------

NODE_ENV=development

# ------------------------------------------------------------
# ------------------------------------------------------------
# STRIPE — Payment processing
# Get these from: https://dashboard.stripe.com/apikeys
# ------------------------------------------------------------

STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------
# CLOUDINARY — Image hosting (optional)
# Used for course thumbnails and hero images
# Get these from: https://cloudinary.com/console
# ------------------------------------------------------------

# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_api_key
# CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------
# BUNNY STREAM — Video hosting and streaming
# Get these from: https://dash.bunny.net/stream
# ------------------------------------------------------------

BUNNY_API_KEY=your_bunny_account_api_key
BUNNY_LIBRARY_ID=your_library_id
BUNNY_LIBRARY_API_KEY=your_library_api_key
BUNNY_CDN_HOSTNAME=vz-XXXXXXXX-XXX.b-cdn.net
NEXT_PUBLIC_BUNNY_LIBRARY_ID=your_library_id

# ------------------------------------------------------------
# RESEND — Transactional email
# Get the API key from: https://resend.com/api-keys
# The "from" address must be on a domain verified in Resend.
# ------------------------------------------------------------

RESEND_API_KEY=re_xxx
EMAIL_FROM="Growth Sales Academy <noreply@your-domain.com>"
EMAIL_REPLY_TO=soporte@your-domain.com

# URL pública del logo que aparece en los emails. Opcional.
# En prod, si no se define, se usa `${NEXTAUTH_URL}/logo_dark.png` (que funciona porque el dominio es público).
# En local, ponla apuntando a una URL pública (Cloudinary, Imgur, etc.) para que se vea el logo en testing.
# EMAIL_LOGO_URL=https://res.cloudinary.com/your-cloud/image/upload/v123/logo_dark.png

# ------------------------------------------------------------
# CRON — Secret used to authorize scheduled jobs hitting public HTTP endpoints
# Generate with: openssl rand -base64 32
# Configure the same value in the VPS crontab Authorization header.
# ------------------------------------------------------------

CRON_SECRET=replace_with_a_strong_random_secret

# ------------------------------------------------------------
# LEADS — Shared API key the landing uses to push leads / read availability / book
# Generate with: openssl rand -hex 32  (must match the value in the landing repo)
# ------------------------------------------------------------

LEADS_API_KEY=replace_with_a_strong_random_secret

# ------------------------------------------------------------
# GOOGLE CALENDAR — OAuth (Web application Client ID) for lead booking
# Create in Google Cloud Console; scopes calendar.events + calendar.freebusy; consent screen in "Testing"
# with the bookable members as test users. See spec_calendar_booking.md §6 / §11.
# ------------------------------------------------------------

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must match EXACTLY an authorized redirect URI registered in GCP.
# Local:      http://localhost:3001/api/integrations/google/callback
# Production: https://app.growthsalessacademy.com/api/integrations/google/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3001/api/integrations/google/callback

# Encryption key for calendar OAuth tokens at rest (32 bytes base64):
#   openssl rand -base64 32
CALENDAR_TOKEN_ENC_KEY=
