datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  STUDENT
}

enum LessonType {
  VIDEO
  TEXT
  FORM
  EXAM
}

enum PaymentType {
  SINGLE
  INSTALLMENTS
}

enum CloserType {
  CRM_ONLY          // Sólo CRM + Método. Sin acceso a cursos.
  CRM_AND_COURSES   // CRM + Método + acceso universal a todos los cursos publicados.
}

enum LeadStatus {
  NUEVO
  CONTACTADO
  AGENDADO
  DESCARTADO
}

enum LeadSituation {
  NO_TRABAJANDO
  MAS_INGRESOS          // tiene trabajo, quiere más ingresos
  QUIERE_REMOTO         // tiene trabajo, quiere remoto
  EMPRENDE_INESTABLE    // emprende, ingresos inestables
  VENDE_PROFESIONALIZAR // vende, quiere profesionalizarse
  YA_CLOSER             // ya closer, quiere mejorar
  OTRA
}

enum LeadUrgency {
  AHORA
  EN_3_MESES
  EN_6_MESES_O_MAS
  NO_SE
  SOLO_INFORMARSE
}

enum LeadInvestment {
  SIN_RECURSOS
  DE_500_A_1000
  DE_1000_A_2000
  SIN_IMPEDIMENTO
}

enum CalendarProvider {
  GOOGLE
  // MICROSOFT  // Fase 2
}

model User {
  id            String    @id @default(cuid())
  name          String
  last_name     String
  username      String    @unique
  phone         String?
  email         String    @unique
  password      String    // Hashed with bcrypt
  profile_image String?
  bio           String?   @db.Text
  title         String?              // Professional title: "Sales Coach", "Closer Senior"
  location      String?              // "CDMX, México"
  role          Role      @default(STUDENT)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  payment_status     String    @default("none")   // none | active | past_due | cancelled
  stripe_customer_id String?   @unique
  blocked            Boolean   @default(false)
  closer_enabled     Boolean    @default(false)
  closer_type        CloserType?            // null cuando closer_enabled = false; obligatorio cuando true
  onboarded_at       DateTime?

  // Welcome video (1-min self-intro). Optional during onboarding; reminded persistently after.
  welcome_video_bunny_id        String?
  welcome_video_status          String?   // 'processing' | 'ready' | 'failed'
  welcome_video_uploaded_at     DateTime?
  welcome_video_snoozed_until   DateTime?

  enrollments        Enrollment[]
  progress           LessonProgress[]
  notes              LessonNote[]
  instructed_courses CourseInstructor[] @relation("CourseInstructor")
  form_submissions   FormSubmission[]
  exam_attempts      ExamAttempt[]
  payments              Payment[]
  created_invitations   Invitation[] @relation("InvitationCreator")
  redeemed_invitations  Invitation[] @relation("InvitationRedeemer")
  sales                 Sale[]
  assigned_leads        Lead[]       @relation("LeadAssignee")

  // Lead booking / Google Calendar (Fase 1 del motor de agendamiento)
  lead_booking_enabled  Boolean              @default(false)             // entra al round-robin de leads
  booking_timezone      String               @default("America/Bogota")  // zona FIJA de su disponibilidad
  working_hours         Json?                                            // ventana de atención por día; null → default L–V 09–18
  calendars             CalendarConnection[] @relation("UserCalendars")

  // GSA Coach IA — historial de evaluaciones de llamadas
  coach_conversations   CoachConversation[]
  coach_usage           CoachUsage[]
}

model Course {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  thumbnail   String?
  hero_image  String?
  price       Float?
  published     Boolean   @default(false)
  order         Int       @default(0)   // Orden global del catálogo (división por tramos de cuotas)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  // Landing redesign — visual/meta fields for the featured cards
  tagline         String? @db.Text
  tier            String?
  level           String?
  duration        String?
  year            String?
  hue             Int?
  accent          String?
  trajectory      String?
  included_items  Json?      // ["Item 1", "Item 2", ...] - shown in "INCLUYE" section of card

  // Student course detail metadata
  language     String? @default("Español")
  certificate  Boolean @default(true)
  requirements Json?              // ["Requisito 1", ...] - shown in "Requisitos" section
  rating       Float?             // 0–5, admin-settable

  instructors CourseInstructor[]
  modules     Module[]
  enrollments Enrollment[]

  @@index([order])
}

model CourseInstructor {
  id         String   @id @default(cuid())
  course_id  String
  user_id    String
  order      Int      @default(0)
  created_at DateTime @default(now())

  course Course @relation(fields: [course_id], references: [id], onDelete: Cascade)
  user   User   @relation("CourseInstructor", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([course_id, user_id])
  @@index([course_id, order])
}

model Module {
  id          String   @id @default(cuid())
  course_id   String
  title       String
  order       Int
  locked      Boolean  @default(false)   // Admin-controlled lock flag shown as "Próximamente" in student UI
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  course      Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  lessons     Lesson[]
}

model Lesson {
  id            String     @id @default(cuid())
  module_id     String
  title         String
  description   String?    @db.Text
  type          LessonType @default(VIDEO)
  video_url      String?
  thumbnail      String?
  bunny_video_id String?
  bunny_status   String?   // 'processing' | 'ready' | 'failed'
  content       String?    @db.Text    // Rich text for TEXT lessons; intro text for FORM/EXAM
  form_schema   Json?                  // Form field definitions for FORM lessons
  exam_schema   Json?                  // Exam questions/options for EXAM lessons
  passing_score Int?                   // Minimum % to pass (EXAM only)
  max_attempts  Int?                   // Max retries (EXAM only, null = unlimited)
  is_final_exam Boolean    @default(false)
  order         Int
  duration      Int?       // In minutes
  resources     Json?      // Array of { id, name, url, type: 'link' | 'file' }
  created_at    DateTime   @default(now())
  updated_at    DateTime   @updatedAt

  module           Module           @relation(fields: [module_id], references: [id], onDelete: Cascade)
  progress         LessonProgress[]
  notes            LessonNote[]
  form_submissions FormSubmission[]
  exam_attempts    ExamAttempt[]
}

model Enrollment {
  id          String    @id @default(cuid())
  user_id     String
  course_id   String
  approved    Boolean   @default(false)
  approved_at DateTime?
  created_at  DateTime  @default(now())

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [course_id], references: [id], onDelete: Cascade)

  @@unique([user_id, course_id])
}

model LessonProgress {
  id           String    @id @default(cuid())
  user_id      String
  lesson_id    String
  completed    Boolean   @default(false)
  completed_at DateTime?
  score        Int?      // Percentage score for EXAM lessons
  passed       Boolean?  // Whether the user passed the exam

  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson       Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@unique([user_id, lesson_id])
}

model LessonNote {
  id          String   @id @default(cuid())
  user_id     String
  lesson_id   String
  content     String   @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@unique([user_id, lesson_id])
}

model FormSubmission {
  id          String   @id @default(cuid())
  user_id     String
  lesson_id   String
  data        Json
  created_at  DateTime @default(now())

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@unique([user_id, lesson_id])
}

model ExamAttempt {
  id          String   @id @default(cuid())
  user_id     String
  lesson_id   String
  answers     Json
  score       Int
  passed      Boolean
  created_at  DateTime @default(now())

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lesson_id], references: [id], onDelete: Cascade)

  @@index([user_id, lesson_id])
}

model Payment {
  id                  String    @id @default(cuid())
  user_id             String
  stripe_checkout_id  String?   @unique
  payment_type        String    // one_time | installment
  amount              Int       // Amount for THIS payment in cents
  currency            String    @default("eur")
  status              String    @default("pending") // pending | completed | failed
  installment_number  Int?      // 1, 2, 3... null for one_time
  installment_plan_id String?   // Groups related installments together
  due_date            DateTime? // When this installment is due
  reminder_sent_at    DateTime? // When the 7-day reminder email was last sent (null = not yet)
  created_at          DateTime  @default(now())
  updated_at          DateTime  @updatedAt

  user                User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([installment_plan_id])
}

model SiteSettings {
  id               String   @id @default("singleton")
  pricing          Json     // { totalPrice: 188800, firstInstallment: 188800, installmentCount: 1 }
  commission_tiers Json?    // [{ min_amount: 0, percentage: 9 }, ...] in cents/percent
  updated_at       DateTime @updatedAt
}

model Sale {
  id                  String      @id @default(cuid())
  closer_id           String
  customer_first_name String
  customer_last_name  String
  customer_email      String
  customer_phone      String
  package_name        String
  package_description String?     @db.Text
  total_amount        Int         // cents
  payment_type        PaymentType
  screenshot_url      String      // path returned from /api/upload
  sale_date           DateTime
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt

  closer       User              @relation(fields: [closer_id], references: [id], onDelete: Cascade)
  installments SaleInstallment[]

  @@index([closer_id])
  @@index([sale_date])
}

model SaleInstallment {
  id           String    @id @default(cuid())
  sale_id      String
  order        Int
  amount       Int       // cents
  due_date     DateTime?
  collected    Boolean   @default(false)
  collected_at DateTime?

  sale Sale @relation(fields: [sale_id], references: [id], onDelete: Cascade)

  @@index([sale_id])
  @@index([collected_at])
}

model Invitation {
  id           String      @id @default(cuid())
  created_by   String
  payment_type String      // one_time | installment
  amount_paid  Int         // cents already paid externally (0 if is_free)
  installments Json?       // [{ number, amount, dueDate }] pending installments
  used         Boolean     @default(false)
  used_by      String?
  used_at      DateTime?
  expires_at   DateTime?
  closer_type  CloserType? // null = invitación de estudiante regular
  is_free      Boolean     @default(false)  // true = no genera Payment records al redimir
  created_at   DateTime    @default(now())

  creator      User      @relation("InvitationCreator", fields: [created_by], references: [id])
  redeemer     User?     @relation("InvitationRedeemer", fields: [used_by], references: [id])
}

model Testimonial {
  id            String   @id @default(cuid())
  name          String
  role          String?
  metric        String?
  quote         String   @db.Text
  duration      String?
  video_url     String?
  hue           Int?
  poster_bg     String?  @db.Text
  poster_accent String?
  order         Int      @default(0)
  published     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@index([published, order])
}

model Lead {
  id              String         @id @default(cuid())

  // Contacto
  full_name       String
  whatsapp        String         // SIEMPRE string (prefijos +, espacios, ceros a la izquierda)
  email           String
  instagram       String
  country         String

  // Cualificación
  situation       LeadSituation
  desired_change  String         @db.Text   // "cambio"
  objectives      String         @db.Text   // "objetivos como closer"
  cafe_vision     String         @db.Text   // "café 6 meses después…"
  urgency         LeadUrgency
  investment      LeadInvestment

  // Reunión (agendada vía Google Calendar conectada a la landing)
  meeting_at      DateTime?                 // start del evento (RFC3339 → timestamptz): instante absoluto
  meeting_tz_iana String?                   // start.timeZone del evento: "America/Bogota" (IANA limpio)
  google_event_id String?        @unique    // id del evento en Google Calendar (enlazar / evitar duplicados)
  google_event_url String?                  // htmlLink del evento
  meeting_link    String?                   // Google Meet (hangoutLink / conferenceData)

  // CRM
  status          LeadStatus     @default(NUEVO)
  source          String         @default("landing-survey")
  assigned_to     String?
  assigned_at     DateTime?

  // Metadatos
  submitted_at    DateTime?                 // "enviado_en" del cliente (epoch ms del navegador)
  created_at      DateTime       @default(now())
  updated_at      DateTime       @updatedAt

  assignee        User?          @relation("LeadAssignee", fields: [assigned_to], references: [id], onDelete: SetNull)

  @@index([status, created_at])
  @@index([assigned_to])
  @@index([email])
}

model CalendarConnection {
  id             String           @id @default(cuid())
  user_id        String
  provider       CalendarProvider @default(GOOGLE)
  account_email  String                          // email de la cuenta de Google conectada
  calendar_id    String           @default("primary")
  refresh_token  String           @db.Text       // CIFRADO en reposo (AES-256-GCM)
  access_token   String?          @db.Text       // cache cifrado; se renueva con el refresh
  token_expiry   DateTime?
  scopes         String           @db.Text
  status         String           @default("active")  // active | error | revoked
  connected_at   DateTime         @default(now())
  updated_at     DateTime         @updatedAt

  user           User             @relation("UserCalendars", fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, provider])
  @@index([status])
}

// GSA Coach IA — una conversación por "sesión de entrenamiento" del alumno.
model CoachConversation {
  id         String   @id @default(cuid())
  user_id    String
  title      String   @default("Nueva llamada")   // derivado del primer mensaje del alumno
  call_type  String?                               // cierre | discovery | seguimiento | ... (Coach-ia.md §15)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user     User           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages CoachMessage[]

  @@index([user_id, updated_at])
}

model CoachMessage {
  id              String   @id @default(cuid())
  conversation_id String
  role            String                       // 'user' | 'assistant'
  content         String   @db.Text
  created_at      DateTime @default(now())

  conversation CoachConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)

  @@index([conversation_id, created_at])
}

// Ajustes del Coach IA editables por Iván desde la web (singleton). Las instrucciones
// adicionales se AÑADEN al método base (Coach-ia.md), sin reemplazarlo.
model CoachSetting {
  id                 String   @id @default("singleton")
  extra_instructions String?  @db.Text
  // Documento Maestro editado desde el panel. NULL = se usa el del build (Coach-ia.md
  // compilado en src/lib/coach/methodology.ts). En cuanto se guarda una edición, ESTA
  // columna pasa a ser la fuente de verdad y el archivo queda solo como original de fábrica.
  methodology        String?  @db.Text
  updated_at         DateTime @updatedAt
  updated_by         String?
}

// Instantánea del Documento Maestro cada vez que se guarda desde el panel.
// El método es el activo principal del coach: sin historial, una edición desafortunada
// degradaría en silencio todas las evaluaciones sin forma de volver atrás.
model CoachMethodologyVersion {
  id         String   @id @default(cuid())
  content    String   @db.Text
  created_at DateTime @default(now())
  created_by String?

  @@index([created_at])
}

// GSA Coach IA — registro REAL de consumo por cada llamada a la API de OpenAI.
// Los tokens vienen del `usage` que devuelve OpenAI (lo que factura); el costo se
// calcula con la tabla de precios (src/lib/coach/pricing.ts) y se guarda como snapshot.
model CoachUsage {
  id                  String   @id @default(cuid())
  user_id             String
  conversation_id     String?
  model               String
  is_evaluation       Boolean  @default(false)   // evaluación (gpt-4o) vs seguimiento (mini)
  input_tokens        Int      @default(0)
  output_tokens       Int      @default(0)
  cached_input_tokens Int      @default(0)
  cost_usd            Decimal  @db.Decimal(12, 6)
  created_at          DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([created_at])
}
